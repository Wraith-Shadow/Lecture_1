<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lists and Tables</title>
</head>
<body>
    <h2>Lists</h2>
    <ul>
        <li>First item of unordered list</li>
        <li>Second item of unordered list</li>
        <li>Third item of unordered list</li>
    </ul>

    <ul type="circle">
        <li>First item of unordered list</li>
        <li>Second item of unordered list</li>
        <li>Third item of unordered list</li>
    </ul>

    <ol>
        <li>First item of ordered list</li>
        <li>Second item of ordered list</li>
        <li>Third item of ordered list</li>
    </ol>

    <ol type="I">
        <li>First item of ordered list</li>
        <li>Second item of ordered list</li>
        <li>Hello
            <ol>
                <li>Any1</li>
                <li>Any2</li>
                <li>Any3</li>
            </ol>
        </li>
        <li>Third item of ordered list</li>
    </ol>

    <!-- Tables -->
    <h2>Tables</h2>
    <Table>
        <thead>
            <tr>
                <th>Name</th>
                <th>ID</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Khabib Nurmagomedov</td>
                <td>UFC Lightweight Champion</td>
                <td>Fighter</td>
            </tr>
            <tr>
                <td>Vladimir Putin</td>
                <td>KGB Agent</td>
                <td>President of Russia</td>
            </tr>
            <tr>
                <td>Ajit Doval</td>
                <td>RAW Agent</td>
                <td>National Security Advisor</td>
            </tr>
        </tbody>
    </Table>
    <br>
    <button onclick="alert('You clicked the button!')">Click me!</button>

</body>
</html>
